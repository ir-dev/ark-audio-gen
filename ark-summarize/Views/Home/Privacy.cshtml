@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="row"><div class="col-lg-8 mx-auto">
<h1 class="mt-3">@ViewData["Title"]</h1>

<p class="text-muted">Last updated: 2026.</p>

<p>
    Ark Summarize is designed to be privacy-respecting. All text analysis runs on the
    server's CPU using a fully self-contained engine — your text is <strong>never</strong>
    sent to any third-party AI provider.
</p>

<h5>What we store</h5>
<ul class="text-muted">
    <li>Your email address, used solely to authenticate you via one-time codes.</li>
    <li>A randomly generated API key and the header name you choose for it.</li>
    <li>Sign-in timestamps.</li>
</ul>

<h5>What we don't store</h5>
<ul class="text-muted">
    <li>We do not retain the text you submit for summarization beyond the duration of the request.</li>
    <li>No passwords (sign-in is passwordless).</li>
</ul>
</div></div>
