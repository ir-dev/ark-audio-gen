@model ArkSummarize.Models.SummarizeViewModel
@{
    ViewData["Title"] = "Summarize";
    var colClass = Model.Results.Count >= 3 ? "col-lg-4" : Model.Results.Count == 2 ? "col-lg-6" : "col-12";
    var firstEngine = Model.SelectedEngines.FirstOrDefault() ?? "lexical";
}

<div class="row">
    <div class="col-lg-10 offset-lg-1">
        <h1 class="mb-1">🧠 Text&nbsp;→&nbsp;Intent · Summary · Entities</h1>
        <p class="text-muted">
            CPU-hosted text analysis. Paste any text, pick one or more engines, and get
            structured JSON back. Select two engines to compare their output side by side.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="Index" method="post" class="card card-body mb-4">
            <div class="mb-3">
                <label asp-for="Text" class="form-label"></label>
                <textarea asp-for="Text" id="Text" class="form-control" rows="9"
                          placeholder="Paste an email, article, review, support ticket — any text you want analysed…">@Model.Text</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Engines <span class="text-muted text-lowercase fw-normal">(tick one or more to compare)</span></label>
                <div class="engine-picker">
                    @foreach (var e in Model.AvailableEngines)
                    {
                        var checkd = Model.SelectedEngines.Contains(e.Key) ? "checked" : null;
                        <label class="engine-choice" title="@e.Description">
                            <input type="checkbox" name="SelectedEngines" value="@e.Key" @checkd />
                            <span class="engine-choice-body">
                                <span class="engine-choice-name">@e.DisplayName
                                    @if (e.Key == "lexical") { <span class="chip ms-1">default</span> }
                                </span>
                                <span class="engine-choice-desc">@e.Description</span>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-sm-4">
                    <label asp-for="MaxSentences" class="form-label"></label>
                    <input asp-for="MaxSentences" id="MaxSentences" type="number" min="1" max="10" class="form-control" />
                </div>
                <div class="col-sm-8 text-sm-end">
                    <button type="submit" class="btn btn-primary px-4">Analyze</button>
                </div>
            </div>
        </form>

        @if (Model.Results.Count > 0)
        {
            <div class="row g-3 mb-4 align-items-stretch">
                @foreach (var run in Model.Results)
                {
                    <div class="@colClass">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between flex-wrap">
                                <span>@run.DisplayName</span>
                                @if (run.Result is not null)
                                {
                                    <small class="text-muted">@run.Result.WordCount words · @run.Result.ProcessingMs.ToString("0.0")ms</small>
                                }
                            </div>
                            <div class="card-body">
                                @if (run.Error is not null)
                                {
                                    <div class="alert alert-danger mb-0">
                                        <strong>This engine couldn't run.</strong><br />@run.Error
                                    </div>
                                }
                                else if (run.Result is not null)
                                {
                                    var r = run.Result;
                                    <div class="result-grid">
                                        <div class="result-label">Intent</div>
                                        <div>
                                            <span class="tag tag-intent">@r.Intent</span>
                                            <span class="text-muted small ms-1">@((r.IntentConfidence * 100).ToString("0"))%</span>
                                        </div>

                                        <div class="result-label">Summary</div>
                                        <div>
                                            @if (string.IsNullOrWhiteSpace(r.Summary))
                                            {
                                                <span class="text-muted"><em>(no summary produced)</em></span>
                                            }
                                            else
                                            {
                                                <p class="mb-0" style="white-space:pre-wrap;">@r.Summary</p>
                                            }
                                        </div>

                                        <div class="result-label">Entities</div>
                                        <div>
                                            @if (r.Entities.Count == 0)
                                            {
                                                <span class="text-muted"><em>(none detected)</em></span>
                                            }
                                            else
                                            {
                                                @foreach (var e in r.Entities)
                                                {
                                                    <span class="entity-pill"><span class="entity-type">@e.Type</span>@e.Text</span>
                                                }
                                            }
                                        </div>

                                        <div class="result-label">Keywords</div>
                                        <div>
                                            @if (r.Keywords.Count == 0)
                                            {
                                                <span class="text-muted"><em>—</em></span>
                                            }
                                            else
                                            {
                                                @foreach (var k in r.Keywords)
                                                {
                                                    <span class="chip me-1 mb-1">@k</span>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <details class="mt-3">
                                        <summary>Raw JSON</summary>
                                        <div class="code-block mt-2" id="json_@run.Key">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }))<button class="copy-btn" type="button" onclick="copyFrom('json_@run.Key', this)">Copy</button></div>
                                    </details>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="card mt-4" id="apiConsole">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>🛠️ API console</span>
                <span class="chip">live <code class="ms-1">/api/summarize</code></span>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    This is the exact request for the text, engine and settings above — copy it
                    straight into your terminal or app. Your personal API key is already filled in.
                    The <code>model</code> field is optional and defaults to <code>lexical</code>.
                </p>
                <div class="code-block">
                    <button class="copy-btn" type="button" onclick="copyFrom('curlConsole', this)">Copy</button><span id="curlConsole" data-endpoint="@Model.ApiBaseUrl" data-keyname="@Model.ApiKeyName" data-keyvalue="@Model.ApiKey" data-model="@firstEngine">curl ...</span></div>
                <p class="text-muted small mt-2 mb-0">
                    List engines with <code>GET /api/models</code>. Manage your key on your
                    <a asp-controller="Account" asp-action="Profile">profile</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
