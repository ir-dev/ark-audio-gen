<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ark Summarize</title>
    <script>(function(){try{document.documentElement.setAttribute('data-theme',localStorage.getItem('ark-theme')||'dark');}catch(e){}})();</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="distribution" content="Global" />
    <meta name="rating" content="General" />
    <meta name="Language" content="en, en-us, en-gb" />
    <link rel="shortcut icon" type="image/png" href="https://immanuel.co/favicon.ico" />
    <meta name="description" content="Ark Summarize — CPU-hosted text summarization that returns intent, summary and entities as JSON, with a developer-friendly API. By Immanuel R." />
    <meta name="keywords" content="Immanuel R, AI, ML, Text Summarization, NLP, Intent Detection, Entity Extraction, Developer API, Offline NLP, ASP.NET Core" />
    <meta name="author" content="Immanuel R" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href="https://immanuel.co/" />
    <link rel="icon" type="image/x-icon" href="https://immanuel.co/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://immanuel.co/" />
    <meta property="og:title" content="Ark Summarize | Text Intelligence on CPU" />
    <meta property="og:description" content="A CPU-hosted text summarization service returning intent, summary and entities as JSON, with a clean developer API." />
    <meta property="og:image" content="https://immanuel.co/data/ark/blog/ark_logo_blog1.png" />
    <meta property="og:site_name" content="Immanuel.co" />
    <meta property="og:locale" content="en_US" />
    <meta name="ai-content-declaration" content="human-assisted-ai-content" />
    <link rel="preconnect" href="https://immanuel.co" />
    <link rel="dns-prefetch" href="https://immanuel.co" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🧠 Ark<span class="brand-dot">.</span>Summarize</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end align-items-center">
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Summarize" asp-action="Index">Summarize</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile">API &amp; Profile</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-ghost btn-sm ms-2">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" fragment="features">Features</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" fragment="api">API</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2" asp-area="" asp-controller="Account" asp-action="Login">Sign in / Sign up</a>
                            </li>
                        }
                        <li class="nav-item ms-sm-2 mt-2 mt-sm-0">
                            <button id="themeToggle" class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle theme">☀️</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container d-flex justify-content-between flex-wrap">
            <span>&copy; 2026 Ark Summarize · built by <a href="https://immanuel.co" target="_blank" rel="noopener">Immanuel R</a></span>
            <span><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
