{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Translation": {
    "Provider": "Onnx",
    "Onnx": {
      "ModelRepo": "Xenova/nllb-200-distilled-600M",
      "QuantizationSuffix": "_quantized",
      "ModelDirectory": "App_Data",
      "Threads": 0,
      "MaxOutputTokens": 256
    },
    "LibreTranslate": {
      "Endpoint": "http://localhost:5000",
      "ApiKey": ""
    }
  }
}
