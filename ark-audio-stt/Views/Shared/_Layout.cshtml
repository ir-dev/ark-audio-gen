<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArkSpeechToText</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArkSpeechToText.styles.css" asp-append-version="true" />
    <meta name="robots" content="index, follow" />
    <meta name="distribution" content="Global" />
    <meta name="rating" content="General" />
    <meta name="identifier-url" content="https://www.immanuel.co" />
    <meta name="Language" content="en, en-us, en-gb, en-bz, en-za" />
    <meta name="viewport" content="initial-scale = 1.0,maximum-scale = 1.0" />
    <link rel="shortcut icon" type="image/png" href="https://immanuel.co/favicon.ico" />
    <meta name="description" content="Official website of Immanuel R — AI/ML knowledge base, open-source contributor, technology consultant, cloud architect, and advisor for startups and small businesses seeking practical and ethical technology leadership." />
    <meta name="keywords" content="Immanuel R, AI, ML, Artificial Intelligence, Machine Learning, Technology Consultant, Cloud Architect, Open Source, Azure, SAP, DevOps, MCP Server, AI Automation, Enterprise Integration, Biblical Technology Consulting, Technology Council, Startup Advisor, NPM, NuGet, GitHub" />
    <meta name="author" content="Immanuel R" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="generator" content="Custom AI/ML Knowledge Platform" />
    <link rel="canonical" href="https://immanuel.co/" />
    <link rel="icon" type="image/x-icon" href="https://immanuel.co/favicon.ico" />
    <link rel="shortcut icon" href="https://immanuel.co/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://immanuel.co/" />
    <meta property="og:title" content="Immanuel R | AI/ML Knowledge Base & Technology Consulting" />
    <meta property="og:description" content="AI/ML knowledge base, cloud-native architecture, enterprise automation, open-source tools, and consulting services for modern businesses." />
    <meta property="og:image" content="https://immanuel.co/data/ark/blog/ark_logo_blog1.png" />
    <meta property="og:site_name" content="Immanuel.co" />
    <meta property="og:locale" content="en_US" />
    <meta name="ai-content-declaration" content="human-assisted-ai-content" />
    <meta name="subject" content="AI/ML Knowledge Base and Technology Consulting" />
    <meta name="classification" content="Technology, AI, Machine Learning, Cloud, Enterprise Architecture" />
    <meta name="category" content="Artificial Intelligence" />
    <meta name="coverage" content="Worldwide" />
    <meta name="distribution" content="Global" />
    <meta name="rating" content="General" />
    <meta name="expertise" content="AI Engineering, Enterprise Integration, Cloud Architecture, SAP Integration, MCP Server, Automation, Open Source" />
    <meta name="consulting-focus" content="Technology strategy for startups and small businesses with ethical and biblical leadership principles" />
    <link rel="preconnect" href="https://immanuel.co" />
    <link rel="dns-prefetch" href="https://immanuel.co" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Transcription" asp-action="Index">ArkSpeechToText</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Transcription" asp-action="Index">Transcribe</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ArkSpeechToText - CPU Whisper transcription
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
