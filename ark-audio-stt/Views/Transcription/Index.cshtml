@model ArkSpeechToText.Models.TranscribeViewModel
@{
    ViewData["Title"] = "Speech to Text";
}

<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <h1 class="mb-1">🎙️ Speech&nbsp;→&nbsp;Text</h1>
        <p class="text-muted">
            CPU-hosted, lightweight transcription powered by Whisper
            (<code>ggml-@Model.ModelSize</code>). Upload a
            <strong>.wav</strong>, <strong>.mp3</strong>, <strong>.ogg</strong>
            or <strong>.opus</strong> file.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="Index" method="post" enctype="multipart/form-data" class="card card-body mb-4">
            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>
                <input asp-for="File" type="file" accept=".wav,.mp3,.ogg,.opus,audio/wav,audio/mpeg,audio/ogg,audio/opus" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Language" class="form-label"></label>
                <select asp-for="Language" class="form-select">
                    <option value="auto">Auto-detect</option>
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                    <option value="fr">French</option>
                    <option value="de">German</option>
                    <option value="hi">Hindi</option>
                    <option value="zh">Chinese</option>
                    <option value="ja">Japanese</option>
                    <option value="ta">Tamil</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Transcribe</button>
        </form>

        @if (Model.Result is not null)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between flex-wrap">
                    <span>Transcript</span>
                    <small class="text-muted">
                        lang: <strong>@Model.Result.Language</strong> ·
                        audio: @Model.Result.Duration.ToString(@"mm\:ss") ·
                        processed in @Model.Result.ProcessingTime.TotalSeconds.ToString("0.0")s
                    </small>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(Model.Result.Text))
                    {
                        <p class="text-muted mb-0"><em>(no speech detected)</em></p>
                    }
                    else
                    {
                        <p style="white-space: pre-wrap;">@Model.Result.Text</p>
                    }

                    @if (Model.Result.Segments.Count > 0)
                    {
                        <details class="mt-3">
                            <summary>Time-stamped segments (@Model.Result.Segments.Count)</summary>
                            <table class="table table-sm mt-2 mb-0">
                                <thead>
                                    <tr><th style="width:8rem;">Start</th><th style="width:8rem;">End</th><th>Text</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var seg in Model.Result.Segments)
                                    {
                                        <tr>
                                            <td>@seg.Start.ToString(@"mm\:ss\.ff")</td>
                                            <td>@seg.End.ToString(@"mm\:ss\.ff")</td>
                                            <td>@seg.Text</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                </div>
            </div>
        }
    </div>
</div>
