# Native runtime AAR is fetched by scripts/fetch-runtime.sh (47 MB; not committed).
app/libs/*.aar

# Model packs are fetched by scripts/fetch-models.sh (hundreds of MB; never committed).
/models/
*.onnx
*.tar.bz2

# Benchmark output written by scripts/benchmark.sh
benchmarks/results/

# The parent repository ignores media files; the small test clips and the screenshot are part of the test suite/docs.
!testdata/audio/*.wav
!testdata/audio/*.m4a
!docs/screenshots/*.png
